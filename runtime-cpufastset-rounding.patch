diff --git a/src/runtime/bios_hle.cpp b/src/runtime/bios_hle.cpp
index 40ba197..40b4119 100644
--- a/src/runtime/bios_hle.cpp
+++ b/src/runtime/bios_hle.cpp
@@ -208,14 +209,17 @@ void do_cpu_set() {
     }
 }
 
-void do_cpu_fast_set() {
+uint32_t do_cpu_fast_set() {
     uint32_t src = R(0), dst = R(1), ctrl = R(2);
-    uint32_t count = ctrl & 0x1FFFFFu;      // word count (games pass multiples of 8)
+    // The BIOS transfers complete eight-word blocks, including a partial
+    // final block. Several games request four words for a 32-byte palette.
+    uint32_t count = ((ctrl & 0x1FFFFFu) + 7u) & ~7u;
     bool fixed = (ctrl >> 24) & 1u;
     for (uint32_t i = 0; i < count; ++i) {
         wr32(dst, rd32(src));
         dst += 4; if (!fixed) src += 4;
     }
+    return count;
 }
 
