--- /dev/null
+++ b/src/runtime/frame_control.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace gbarecomp {
+// A game-owned frame driver runs on the guest thread, at fully unwound native
+// dispatch boundaries. The engine retains the machine, devices and ROM checks.
+// Save/load includes the runtime clock; presentation and sockets stay outside.
+struct NativeFrameControl {
+    struct AudioBlock { std::uint32_t rate=0;std::vector<std::int16_t> samples; };
+    std::function<bool(std::uint16_t)> advance; // active-low P1 KEYINPUT
+    std::function<bool(std::vector<std::uint8_t>&,std::string&)> save;
+    std::function<bool(const std::vector<std::uint8_t>&,std::string&)> load;
+    std::function<void(std::vector<AudioBlock>&)> drain_audio;
+    std::function<const std::uint8_t*()> pixels; // latched RGB888, native 240x160
+    std::function<std::uint64_t()> frame;
+    std::function<void(std::int64_t)> seed_clock;
+};
+}
