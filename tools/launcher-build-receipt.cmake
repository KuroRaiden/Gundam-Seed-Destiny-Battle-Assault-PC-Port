file(SHA256 "${APP}" APP_HASH)
get_filename_component(APP_FOLDER "${APP}" DIRECTORY)
set(RECEIPT "{\n  \"version\": \"${VERSION}\",\n  \"sha256\": \"${APP_HASH}\"\n}\n")
file(MAKE_DIRECTORY "${APP_FOLDER}/config" "${DESTINATION}/config")
file(WRITE "${APP_FOLDER}/config/launcher-build.json" "${RECEIPT}")
file(WRITE "${DESTINATION}/config/launcher-build.json" "${RECEIPT}")
